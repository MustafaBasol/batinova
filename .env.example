# BatiNova — environment template (versioned; contains NO secrets).
# Copy to `.env` for local development. In production, inject real values via
# the hosting platform's secret manager — never commit them.
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- Core -------------------------------------------------------------------
NODE_ENV=development
# Canonical public origin (no trailing slash). Used for canonical URLs, sitemap, OG.
SITE_URL=https://btnv.fr

# --- Database ---------------------------------------------------------------
# SQLite file, path relative to the project root. In production point this at a
# PERSISTENT volume, e.g. file:/var/lib/batinova/db/batinova.db
DATABASE_URL=file:./prisma/dev.db

# --- Secrets (REQUIRED, >= 32 chars each, distinct values) --------------------
# Pepper / HMAC key reserved for session-related signing.
SESSION_SECRET=replace-with-generated-secret
# HMAC key used to hash client IPs for rate limiting and lead records (raw IPs are never stored).
IP_HASH_SECRET=replace-with-generated-secret

# --- Storage (MUST be persistent volumes in production) -----------------------
# Public media served by /media/<key>
MEDIA_STORAGE_DIR=./storage/media
# Private files (lead attachments). NEVER publicly served.
PRIVATE_STORAGE_DIR=./storage/private

# --- Mail (disabled unless ALL SMTP_* + MAIL_FROM are set AND the admin setting
# `mail.enabled` is true). Hostinger suggestion: smtp.hostinger.com, port 465, secure=true.
# Leave empty until the mailbox exists and MX/SPF/DKIM/DMARC are verified.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Example: "BatiNova Construction <contact@btnv.fr>" (must be an address you control)
MAIL_FROM=

# --- Admin bootstrap (used only by `npm run admin:create`; prefer the interactive prompt) ---
# ADMIN_INITIAL_PASSWORD=

# --- Proxy trust ---------------------------------------------------------------
# Set to "true" only when running behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# --- Local-only escape hatch (NEVER on a real deployment) ----------------------------
# Production mode normally requires absolute DATABASE_URL/MEDIA_STORAGE_DIR/PRIVATE_STORAGE_DIR and an https SITE_URL.
# Set to "true" only to run `next start` on a laptop (used by the E2E harness).
# ALLOW_EPHEMERAL_PATHS=false

# --- SEO / indexing (seo-content) -------------------------------------------
# Search engines may index the site ONLY when this is exactly "true" (production, https://btnv.fr).
# Anything else (unset, staging, preview, dev) => robots.txt "Disallow: /", empty sitemap,
# X-Robots-Tag + <meta robots> noindex on every page.
SITE_INDEXING=false
# Public host that must be used (apex). When set, requests to "www.<host>" get a 301 to https://<host>.
# Leave empty on localhost/previews. Production: btnv.fr
CANONICAL_HOST=

# --- CSP / analytics (architect-security) -----------------------------------------
# Third-party analytics origins are added to the Content-Security-Policy ONLY for the provider named here
# ("plausible" or "ga4"). Read at BUILD time (headers are baked into the build). Leave empty = no third-party origin.
# Enabling analytics also needs the admin analytics setting + visitor consent.
CSP_ANALYTICS_PROVIDER=
