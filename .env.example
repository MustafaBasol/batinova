# BatiNova — environment template (versioned; contains NO secrets).
# Copy to `.env` for local development. In production, inject real values via
# the hosting platform's secret manager — never commit them.
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- Core -------------------------------------------------------------------
NODE_ENV=development
# Canonical public origin (no trailing slash). Used for canonical URLs, sitemap, OG.
SITE_URL=https://btnv.fr

# --- Database (MySQL / MariaDB — Hostinger) ---------------------------------------
# mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE — percent-encode special characters in USER/PASSWORD.
# Hostinger Node.js apps: the host MUST be 127.0.0.1 ("localhost" resolves to ::1 and is refused; the app rejects it).
# Optional query params: ?connectionLimit=5 (1..20, mind Hostinger's per-user connection cap) &ssl=true.
# Local development: a throwaway database whose name contains "dev" or "test".
DATABASE_URL=mysql://root@127.0.0.1:3306/batinova_dev

# --- Secrets (REQUIRED, >= 32 chars each, distinct values) --------------------
# Pepper / HMAC key reserved for session-related signing.
SESSION_SECRET=replace-with-generated-secret
# HMAC key used to hash client IPs for rate limiting and lead records (raw IPs are never stored).
IP_HASH_SECRET=replace-with-generated-secret
# Bearer token for the cron-called endpoints (/api/maintenance/purge, /api/maintenance/proxy-check).
# Leave EMPTY to keep them disabled (404). Distinct from the other secrets.
MAINTENANCE_TOKEN=

# --- File storage -------------------------------------------------------------
# "local" (default): directories below, which MUST live OUTSIDE hbuilds/ and public_html/ (Hostinger overwrites those on
# every deployment). The app refuses to start when the directories were wiped (see docs/DEPLOYMENT.md §4).
# "s3": S3-compatible bucket (provider chosen by the owner) — then the S3_* values below are required.
STORAGE_DRIVER=local
# Public media served by /media/<key>
MEDIA_STORAGE_DIR=./storage/media
# Private files (lead attachments). NEVER publicly served.
PRIVATE_STORAGE_DIR=./storage/private
# S3 (only when STORAGE_DRIVER=s3). The bucket must be PRIVATE (block public access).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=

# --- Mail (disabled unless ALL SMTP_* + MAIL_FROM are set AND the admin setting
# `mail.enabled` is true). Hostinger suggestion: smtp.hostinger.com, port 465, secure=true.
# Leave empty until the mailbox exists and MX/SPF/DKIM/DMARC are verified.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Example: "BatiNova Construction <contact@btnv.fr>" (must be an address you control)
MAIL_FROM=

# --- Admin bootstrap -----------------------------------------------------------
# `npm run admin:create` (CLI): ADMIN_INITIAL_PASSWORD is read only by that script; prefer the interactive prompt.
# ADMIN_INITIAL_PASSWORD=
# First OWNER without a shell (Hostinger): generate the hash ON YOUR COMPUTER with `npm run admin:hash`, set these three
# variables ONCE, deploy, then REMOVE them. Inert as soon as any OWNER exists. The clear password is never an env var.
# BOOTSTRAP_OWNER_EMAIL=
# BOOTSTRAP_OWNER_NAME=
# BOOTSTRAP_OWNER_PASSWORD_HASH=

# --- Proxy trust ---------------------------------------------------------------
# Set to "true" only when running behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Number of trusted proxies that APPEND to X-Forwarded-For (1..5). The client is the Nth entry from the right.
# Measure it on Hostinger with POST /api/maintenance/proxy-check (needs MAINTENANCE_TOKEN) before enabling TRUST_PROXY.
# TRUST_PROXY_HOPS=1
# Alternative: a single-value header that YOUR edge overwrites (x-real-ip, cf-connecting-ip, true-client-ip, x-client-ip).
# CLIENT_IP_HEADER=

# --- Local-only escape hatch (NEVER on a real deployment) ----------------------------
# Production mode normally requires absolute DATABASE_URL/MEDIA_STORAGE_DIR/PRIVATE_STORAGE_DIR and an https SITE_URL.
# Set to "true" only to run `next start` on a laptop (used by the E2E harness).
# ALLOW_EPHEMERAL_PATHS=false

# --- SEO / indexing (seo-content) -------------------------------------------
# Search engines may index the site ONLY when this is exactly "true" (production, https://btnv.fr).
# Anything else (unset, staging, preview, dev) => robots.txt "Disallow: /", empty sitemap,
# X-Robots-Tag + <meta robots> noindex on every page.
SITE_INDEXING=false
# Public host that must be used (apex). When set, requests to "www.<host>" get a 301 to https://<host>.
# Leave empty on localhost/previews. Production: btnv.fr
CANONICAL_HOST=

# --- CSP / analytics (architect-security) -----------------------------------------
# Third-party analytics origins are added to the Content-Security-Policy ONLY for the provider named here
# ("plausible" or "ga4"). Read at BUILD time (headers are baked into the build). Leave empty = no third-party origin.
# Enabling analytics also needs the admin analytics setting + visitor consent.
CSP_ANALYTICS_PROVIDER=
